# Backend image (FastAPI + RAG pipeline). Build from the repo root.
FROM python:3.10-slim
COPY --from=ghcr.io/astral-sh/uv:0.7.11 /uv /uvx /bin/

# OMP_NUM_THREADS is set in api/main.py from the CPU count of the container
ENV TOKENIZERS_PARALLELISM=false PYTHONUNBUFFERED=1 UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy

# Dependencies before code, so this layer stays cached when only code changes
WORKDIR /app
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen --no-dev --no-install-project
ENV PATH="/app/.venv/bin:$PATH"

# COPY of a directory copies its contents, so each one needs its own destination
COPY src ./src
COPY api ./api
COPY eval ./eval
COPY evaluate.py ./

EXPOSE 8000
# 0.0.0.0 so other containers can reach it (the default is 127.0.0.1)
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
